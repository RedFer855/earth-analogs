# Fin de línea LF en el repositorio para todo archivo de texto.
# Los scripts de la bóveda esperan LF.
* text=auto eol=lf

# Scripts de Windows necesitan CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binarios
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.pdf   binary
*.docx  binary
*.xlsx  binary
*.m4a   binary
*.jar   binary
*.keystore binary
*.jks   binary
graphify-out/graph.json merge=graphify
